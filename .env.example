# ===================================================================
# CONFIGURACIÓN DE NUBE PARA VERCEL (JULIÉ BAKERY)
# ===================================================================

# 1. VERCEL BLOB (RECOMENDADO - 1 CLIC EN VERCEL)
# En tu dashboard de Vercel (https://vercel.com/dashboard):
# Pestaña "Storage" -> "Create Database" o "Connect Store" -> "Blob".
# ¡Vercel inyecta automáticamente esta variable en tu proyecto!
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# 2. OPCIONAL: CLOUDINARY (Si preferís usar Cloudinary para fotos)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_UPLOAD_PRESET=tu_preset_unsigned

# 3. OPCIONAL: UPSTASH REDIS / VERCEL KV (Para base de datos adicional)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
