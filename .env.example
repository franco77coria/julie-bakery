# ===================================================================
# CONFIGURACIÓN DE NUBE PARA VERCEL (JULIÉ BAKERY)
# ===================================================================

# 1. CONTRASEÑA DE ADMINISTRADORA (VARIABLE DE ENTORNO)
# Definí aquí la contraseña para el panel /admin de Julie:
ADMIN_USER=julie.bakery
ADMIN_PASSWORD=tu_contraseña_segura_aqui

# 2. VERCEL BLOB (ALMACENAMIENTO DE IMÁGENES Y CATÁLOGO EN LA NUBE)
# En tu dashboard de Vercel (https://vercel.com/dashboard):
# Pestaña "Storage" -> "Create Database" o "Connect Store" -> "Blob".
# ¡Vercel inyecta automáticamente esta variable en tu proyecto!
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# 3. OPCIONAL: CLOUDINARY (Si preferís usar Cloudinary para fotos)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_UPLOAD_PRESET=tu_preset_unsigned

# 4. OPCIONAL: UPSTASH REDIS / VERCEL KV
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
